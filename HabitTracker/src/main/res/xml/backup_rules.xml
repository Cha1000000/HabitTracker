<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower.
   See https://developer.android.com/guide/topics/data/autobackup
   On Android 12+ data_extraction_rules.xml is used instead.
-->
<full-backup-content>
    <!-- Отметка незаконченного удаления аккаунта действует только на этом устройстве:
         восстановленная из бэкапа, она остановила бы синхронизацию на новом -->
    <exclude domain="sharedpref" path="account_deletion.xml"/>
</full-backup-content>
