<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow/Glow imitation -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#0D000000" /> <!-- Very faint shadow -->
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp" />
        </shape>
    </item>

    <!-- Main Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="#F0F9FF"
                android:centerColor="#E0F2FE"
                android:endColor="#BAE6FD"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>

    <!-- Inner Highlight -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
             <corners android:radius="23dp" />
             <gradient
                 android:type="linear"
                 android:angle="90"
                 android:startColor="#40FFFFFF"
                 android:endColor="#00FFFFFF" 
                 android:centerY="0.5"/>
        </shape>
    </item>
</layer-list>
